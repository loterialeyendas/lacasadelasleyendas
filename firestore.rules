rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Perfiles de Usuario y Pasaportes (Soporte offline-first y multijugador)
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && (request.auth.uid == userId || !exists(/databases/$(database)/documents/users/$(userId)));
    }

    // Salas Multijugador en Vivo (Mayordomo e Invitados)
    match /rooms/{roomId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if request.auth != null && (resource.data.hostId == request.auth.uid || resource.data.players.size() <= 1);
    }

    // Colección de Leyendas y Recursos Educativos (Solo lectura para clientes)
    match /leyendas/{legendId} {
      allow read: if true;
      allow write: if false;
    }

    // Contenido Editorial y CMS del Sitio (Landing, Estaciones, Portadas e Imágenes)
    match /site_content/{contentId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
