rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Perfiles de Usuario y Pasaportes
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Salas Multijugador en Vivo
    match /rooms/{roomId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null && resource.data.hostId == request.auth.uid;
    }

    // Colección de Leyendas y Recursos Educativos (Solo lectura para clientes)
    match /leyendas/{legendId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
