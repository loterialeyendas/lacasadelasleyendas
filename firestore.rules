rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Perfiles de Usuario y Pasaportes (Soporte offline-first y multijugador)
    match /users/{userId} {
      allow read, write: if true;
    }

    // Salas Multijugador en Vivo (Mayordomo e Invitados)
    match /rooms/{roomId} {
      allow read, write: if true;
    }

    // Colección de Leyendas y Recursos Educativos (Solo lectura para clientes)
    match /leyendas/{legendId} {
      allow read: if true;
      allow write: if false;
    }

    // Contenido Editorial y CMS del Sitio (Landing, Estaciones, Portadas e Imágenes)
    match /site_content/{contentId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
